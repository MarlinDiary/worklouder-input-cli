new file mode 100644
index 0000000..e888297
--- /dev/null
+++ b/spec/schemas/release-archive-v1.schema.json
@@ -0,0 +1,43 @@
+{
+  "$schema": "https://json-schema.org/draft/2020-12/schema",
+  "$id": "https://worklouderctl.dev/schemas/release-archive-v1.schema.json",
+  "title": "WorkLouderCTL release archive manifest v1",
+  "type": "object",
+  "additionalProperties": false,
+  "required": ["schemaVersion", "kind", "version", "target", "signatureState", "files"],
+  "properties": {
+    "schemaVersion": { "const": 1 },
+    "kind": { "const": "worklouderctl-release-archive" },
+    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$" },
+    "target": { "enum": ["aarch64-apple-darwin", "x86_64-apple-darwin"] },
