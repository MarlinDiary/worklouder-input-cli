+tar -xzf "$archive" -C "$root"
+binary=$(find "$root" -type f -path '*/bin/worklouderctl' -print -quit)
+manifest=$(find "$root" -type f -name manifest.json -print -quit)
+test -n "$binary"
+test -n "$manifest"
+signature_state=$(python3 -c \
