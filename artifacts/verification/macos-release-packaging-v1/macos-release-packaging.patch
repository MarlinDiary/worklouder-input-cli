@@ -0,0 +1,28 @@
+class Worklouderctl < Formula
+  desc "Full-configuration CLI for Codex Micro and Work Louder Input"
+  homepage "https://github.com/MarlinDiary/worklouder-input-cli"
+  version "@VERSION@"
+  license "MIT"
+
+  on_macos do
+    if Hardware::CPU.arm?
+      url "@BASE_URL@/worklouderctl-v@VERSION@-aarch64-apple-darwin.tar.gz"
+      sha256 "@ARM64_SHA256@"
+    else
+      url "@BASE_URL@/worklouderctl-v@VERSION@-x86_64-apple-darwin.tar.gz"
+      sha256 "@X86_64_SHA256@"
+    end
+  end
+
+  def install
+    bin.install "bin/worklouderctl"
+    bash_completion.install "completions/worklouderctl.bash" => "worklouderctl"
+    zsh_completion.install "completions/_worklouderctl"
+    fish_completion.install "completions/worklouderctl.fish"
+    doc.install "README.md"
+  end
+
+  test do
+    assert_match version.to_s, shell_output("#{bin}/worklouderctl version")
+  end
+end
