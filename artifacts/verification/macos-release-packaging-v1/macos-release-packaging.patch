+#!/bin/sh
+set -eu
+
+repo=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
+archive=${1:?usage: verify-macos-release.sh ARCHIVE}
+root=$(mktemp -d /tmp/worklouderctl-macos-release.XXXXXX)
+cleanup() { rm -rf "$root"; }
+trap cleanup EXIT INT TERM
+
