+    let object = candidate
+        .as_object()
+        .context("reset candidate was not an object")?;
+    let device_kit_version = object
+        .get("deviceKitVersion")
+        .and_then(Value::as_str)
+        .context("reset candidate omitted deviceKitVersion")?;
