+        schema_version: 1,
+        kind: "worklouderctl-input-firmware-update-receipt".into(),
+        adapter: ADAPTER.into(),
+        input_app_version: client.handshake.input_version.clone(),
+        device_kit_version: plan.device_kit_version.clone(),
