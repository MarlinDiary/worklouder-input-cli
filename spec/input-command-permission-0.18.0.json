{
  "schemaVersion": 1,
  "kind": "worklouder-input-command-permission-model",
  "inputVersion": "0.18.0",
  "source": {
    "asarPath": "/Applications/input.app/Contents/Resources/app.asar",
    "asarSha256": "8e530188bc693ca1b9950bdc0515adfc349a3563e1841fe61ff2d692dc6b2da8",
    "mainBundle": "dist-electron/main/index.js",
    "mainBundleSha256": "7c16191956acb8d0d89c50eb940dc9b757bf6966b19c56499ca2d60d8743154a",
    "rendererChunk": "dist/assets/device_config_data-BMUs-0m4.js",
    "rendererChunkSha256": "c8eba0d7eb069289d6c2a9d649477e1150647cd4fdc1f262784cc518a190573e"
  },
  "storage": {
    "file": "input_storage.json",
    "database": "LokiJS",
    "collection": "app_settings",
    "recordSelection": "findOne, equivalent to the first data record",
    "field": "smartActionCmdEnabled",
    "type": "boolean",
    "newSettingsDefault": false,
    "saveBehavior": "Object.assign into the first record, collection update, then saveDatabase"
  },
  "renderer": {
    "read": "getAppSettings().smartActionCmdEnabled",
    "write": "mutate the app-settings DTO and send common-send-app-settings",
    "surfaces": [
      "Smart Action command editor warning switch",
      "Settings command-action switch"
    ]
  },
  "runtime": {
    "notification": "kb.sa.exec",
    "disabledBehavior": "return before reading or executing params.cmd",
    "enabledBehavior": "validate params.cmd as a non-empty string, then delegate execution to Input's host runtime"
  },
  "candidateBoundary": {
    "writesInputStorage": false,
    "contactsInput": false,
    "contactsDevice": false,
    "preserveUnknownDatabaseContent": true,
    "applyAuthority": "Input Companion Bridge app-settings transaction"
  }
}
