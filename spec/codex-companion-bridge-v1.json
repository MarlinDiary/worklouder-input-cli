{
  "schemaVersion": 1,
  "kind": "worklouderctl-codex-companion-bridge-contract",
  "protocolVersion": 1,
  "contractAppVersion": "26.730.61309",
  "authority": [
    "codex-settings",
    "codex-global-state",
    "codex-runtime"
  ],
  "staticEvidence": {
    "appBundle": "/Applications/ChatGPT.app",
    "bundleIdentifier": "com.openai.codex",
    "asarRelativePath": "Contents/Resources/app.asar",
    "asarSha256": "9de942a9a058fca20b78d171032e0fe65ccb1063868f175ff7eb4e159efc2c38",
    "nativeHandlers": [
      "settings-read",
      "settings-write",
      "get-global-state",
      "set-global-state"
    ],
    "rendererTransport": "POST vscode://codex/{method}",
    "externalListenerObserved": false
  },
  "discovery": {
    "socket": "$HOME/Library/Application Support/Codex/worklouderctl-codex-bridge-v1.sock",
    "token": "$HOME/Library/Application Support/Codex/worklouderctl-codex-bridge-v1.token",
    "environmentSocket": "WORKLOUDERCTL_CODEX_BRIDGE_SOCKET",
    "environmentToken": "WORKLOUDERCTL_CODEX_BRIDGE_TOKEN_FILE",
    "mode": "0600",
    "transport": "JSON-RPC 2.0 newline frames over Unix socket"
  },
  "handshake": {
    "method": "bridge.hello",
    "request": [
      "protocolVersion",
      "token",
      "client.name",
      "client.version"
    ],
    "response": [
      "protocolVersion",
      "bridgeVersion",
      "codexVersion",
      "sessionId",
      "capabilities"
    ]
  },
  "methods": {
    "bridge.health": "bridge.health.v1",
    "codex.settings.snapshot": "codex.settings.snapshot.v1",
    "codex.settings.apply": "codex.settings.apply.v1",
    "codex.settings.restore": "codex.settings.restore.v1",
    "codex.agentKeys.snapshot": "codex.agentKeys.snapshot.v1",
    "codex.agentKeys.apply": "codex.agentKeys.apply.v1",
    "codex.agentKeys.restore": "codex.agentKeys.restore.v1",
    "codex.device.focus": "codex.device.focus.v1",
    "codex.runtime.status": "codex.runtime.status.v1",
    "codex.runtime.recover": "codex.runtime.recover.v1"
  },
  "settingsSnapshot": {
    "kind": "worklouderctl-codex-settings-snapshot",
    "fields": [
      "filePath",
      "sourceSha256",
      "settings",
      "effectiveSettings",
      "definitions",
      "settingsRevision"
    ],
    "settingsRevisionAlgorithm": "codex-settings-revision-v1"
  },
  "mutation": {
    "resultKind": "worklouderctl-codex-settings-mutation",
    "requiredRequestFields": [
      "expectedSourceSha256",
      "expectedSettingsRevision",
      "targetSettingsRevision",
      "idempotencyKey",
      "settings",
      "effectiveSettings"
    ],
    "sequence": [
      "serialize on Codex main-process queue",
      "snapshot current settings and source hash",
      "compare source SHA-256 and settings revision",
      "replace the complete explicit Codex Micro settings set through Codex authority",
      "flush",
      "snapshot and validate exact explicit/effective readback",
      "restore pre-mutation snapshot after any readback failure"
    ],
    "capabilityGate": "apply/restore are advertised only when the integration supplies exact replace including removal of formerly absent keys",
    "idempotencyScope": "bridge session"
  },
  "agentKeys": {
    "snapshotKind": "worklouderctl-codex-agent-keys-snapshot",
    "mutationResultKind": "worklouderctl-codex-agent-keys-mutation",
    "globalStateKey": "codex-micro-custom-agent-assignments",
    "slots": [
      "AG00",
      "AG01",
      "AG02",
      "AG03",
      "AG04",
      "AG05"
    ],
    "default": {
      "AG00": null,
      "AG01": null,
      "AG02": null,
      "AG03": null,
      "AG04": null,
      "AG05": null
    },
    "assignmentTypes": {
      "thread": {
        "required": [
          "hostId",
          "threadKey",
          "title"
        ]
      },
      "command": {
        "required": [
          "type",
          "commandId"
        ],
        "type": "command"
      },
      "skill": {
        "required": [
          "type",
          "skillName",
          "skillPath"
        ],
        "type": "skill"
      },
      "keycap": {
        "required": [
          "keycapId"
        ]
      },
      "empty": null
    },
    "globalStateRevisionAlgorithm": {
      "id": "codex-agent-keys-revision-v1",
      "prefixUtf8": "worklouder-codex-agent-keys-revision-v1\\u0000",
      "payload": "recursive-key-sorted compact JSON"
    },
    "mutationRequiredRequestFields": [
      "expectedGlobalStateRevision",
      "targetGlobalStateRevision",
      "idempotencyKey",
      "assignments"
    ],
    "mutationSequence": [
      "serialize on Codex main-process queue",
      "snapshot current assignments and revision",
      "compare global-state revision",
      "replace all six assignments through set-global-state",
      "snapshot and validate exact readback",
      "restore pre-mutation assignments after any readback failure"
    ],
    "capabilityGate": "apply/restore are advertised only when the integration supplies an exact global-state writer"
  },
  "deviceFocus": {
    "capability": "codex.device.focus.v1",
    "authority": "running Codex CodexMicroService",
    "sequence": [
      "serialize on Codex main-process queue",
      "capture connected service identity and status",
      "forward appName, process, and path through sendFocusApp",
      "read back device status and optional expected layer",
      "verify the same API, comm, and connection attempt remain active"
    ]
  },
  "runtime": {
    "authority": "running Codex CodexMicroService",
    "transport": "persistent authenticated Unix socket after exact-release bootstrap",
    "statusSequence": [
      "serialize on Codex main-process queue",
      "capture the live service without replacing it",
      "read device, control-plane, Promise, and subscription state",
      "return exact state without opening an inspector or signaling the process"
    ],
    "recoverySequence": [
      "capture the pre-recovery service state",
      "bounded stop with stale-comm cleanup",
      "restart the released service with startup-only lighting and battery bypass",
      "restore the original released methods",
      "require connected state, settled Promises, and HID plus joystick subscriptions"
    ],
    "timeoutSeconds": {
      "minimum": 1,
      "maximum": 25
    }
  },
  "limits": {
    "tokenBytes": 4096,
    "requestBytes": 16777216,
    "responseBytes": 16777216,
    "idempotencyEntries": 256
  },
  "boundary": {
    "shipsDriver": false,
    "implementsCodexRuntime": true,
    "editsChromiumLevelDb": false,
    "editsAppAsar": false,
    "integrationOwner": "running Codex main process",
    "runtimeImplementation": "delegates to the existing exact-release CodexMicroService"
  }
}
