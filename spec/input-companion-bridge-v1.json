{
  "schemaVersion": 1,
  "kind": "worklouderctl-input-companion-bridge-contract",
  "protocol": {
    "name": "worklouder-input-companion",
    "version": 1,
    "framing": "utf8-json-lines",
    "rpc": "json-rpc-2.0",
    "maxRequestBytes": 67108864,
    "maxResponseBytes": 67108864
  },
  "discovery": {
    "macosSocketRelativePath": "Library/Application Support/input/worklouderctl-bridge-v1.sock",
    "macosTokenRelativePath": "Library/Application Support/input/worklouderctl-bridge-v1.token",
    "environmentSocket": "WORKLOUDERCTL_BRIDGE_SOCKET",
    "environmentToken": "WORKLOUDERCTL_BRIDGE_TOKEN_FILE"
  },
  "security": {
    "network": "unix-domain-socket-only",
    "socketMode": "0600",
    "tokenMode": "0600",
    "authentication": "token-in-bridge.hello",
    "minimumTokenBytes": 32,
    "remoteListening": false,
    "shellEvaluation": false
  },
  "handshake": {
    "method": "bridge.hello",
    "requiredParams": [
      "protocolVersion",
      "token",
      "client.name",
      "client.version"
    ],
    "resultFields": [
      "protocolVersion",
      "bridgeVersion",
      "inputVersion",
      "sessionId",
      "capabilities"
    ]
  },
  "methods": [
    {
      "name": "bridge.hello",
      "capability": "bridge.handshake.v1",
      "mutation": false
    },
    {
      "name": "bridge.health",
      "capability": "bridge.health.v1",
      "mutation": false
    },
    {
      "name": "device.list",
      "capability": "device.list.v1",
      "mutation": false
    },
    {
      "name": "device.status",
      "capability": "device.status.v1",
      "mutation": false
    },
    {
      "name": "device.files.list",
      "capability": "device.files.list.v1",
      "mutation": false
    },
    {
      "name": "device.files.read",
      "capability": "device.files.read.v1",
      "mutation": false,
      "binaryEncoding": "base64"
    },
    {
      "name": "device.config.snapshot",
      "capability": "device.config.snapshot.v1",
      "mutation": false,
      "params": [
        "deviceId"
      ],
      "resultKind": "worklouder-input-config-snapshot"
    },
    {
      "name": "device.config.validate",
      "capability": "device.config.validate.v1",
      "mutation": false,
      "requiredParams": [
        "snapshot"
      ],
      "optionalParams": [
        "deviceId",
        "expectedRevision"
      ],
      "resultKind": "worklouder-input-config-validation"
    },
    {
      "name": "device.config.apply",
      "capability": "device.config.apply.v1",
      "mutation": true,
      "requiredParams": [
        "deviceId",
        "expectedRevision",
        "idempotencyKey",
        "config"
      ],
      "resultKind": "worklouder-input-config-mutation"
    },
    {
      "name": "device.config.restore",
      "capability": "device.config.restore.v1",
      "mutation": true,
      "requiredParams": [
        "deviceId",
        "expectedRevision",
        "idempotencyKey",
        "snapshot"
      ],
      "resultKind": "worklouder-input-config-mutation"
    },
    {
      "name": "input.host-settings.snapshot",
      "capability": "input.host-settings.snapshot.v1",
      "mutation": false,
      "resultKind": "worklouder-input-host-settings"
    },
    {
      "name": "input.host-settings.apply",
      "capability": "input.host-settings.apply.v1",
      "mutation": true,
      "requiredParams": [
        "expectedRevision",
        "idempotencyKey",
        "settings"
      ],
      "resultKind": "worklouder-input-host-settings-mutation"
    },
    {
      "name": "input.host-settings.restore",
      "capability": "input.host-settings.restore.v1",
      "mutation": true,
      "requiredParams": [
        "expectedRevision",
        "idempotencyKey",
        "snapshot"
      ],
      "resultKind": "worklouder-input-host-settings-mutation"
    },
    {
      "name": "input.presets.snapshot",
      "capability": "input.presets.snapshot.v1",
      "mutation": false,
      "resultKind": "worklouder-input-preset-catalog"
    },
    {
      "name": "input.appsense.runtime",
      "capability": "input.appsense.runtime.v1",
      "mutation": false,
      "optionalParams": [
        "deviceId"
      ],
      "resultKind": "worklouder-input-appsense-runtime"
    },
    {
      "name": "input.permissions.status",
      "capability": "input.permissions.status.v1",
      "mutation": false,
      "optionalParams": [
        "deviceId"
      ],
      "resultKind": "worklouder-input-permissions-status"
    },
    {
      "name": "input.firmware.status",
      "capability": "input.firmware.status.v1",
      "mutation": false,
      "optionalParams": [
        "deviceId"
      ],
      "resultKind": "worklouder-input-firmware-status"
    },
    {
      "name": "input.logs.snapshot",
      "capability": "input.logs.snapshot.v1",
      "mutation": false,
      "optionalParams": [
        "maxEntries"
      ],
      "resultKind": "worklouder-input-log-snapshot"
    }
  ],
  "errors": {
    "-32001": "authentication-failed",
    "-32002": "protocol-version-unsupported",
    "-32003": "capability-unavailable",
    "-32004": "device-not-found",
    "-32005": "revision-conflict",
    "-32006": "input-busy",
    "-32007": "policy-denied",
    "-32008": "adapter-failure"
  },
  "mutationRules": {
    "serializedByInput": true,
    "compareAndSwapRevision": true,
    "idempotencyRequired": true,
    "idempotencyScope": "Input-process-session",
    "idempotencyConflict": "same key with different operation, device, expected revision, or target revision is invalid",
    "snapshotBeforeApply": true,
    "readbackAfterApply": true,
    "rollbackOnFailure": true
  },
  "mutationResult": {
    "schemaVersion": 1,
    "kind": "worklouder-input-config-mutation",
    "fields": [
      "operation",
      "idempotencyKey",
      "idempotentReplay",
      "changed",
      "rollbackPerformed",
      "deviceId",
      "beforeRevision",
      "afterRevision",
      "targetRevision",
      "fileCount",
      "totalBytes"
    ]
  },
  "configurationWriter": {
    "capabilityAdvertisement": "apply and restore are advertised only when replaceConfiguration is injected",
    "replaceSemantics": "complete configuration file set",
    "requiredOwnership": "Input existing device queue and state synchronization",
    "requiredReadback": "device.config.snapshot revision must equal target revision",
    "automaticRollback": "replace complete pre-mutation snapshot and verify its revision"
  },
  "configurationSnapshots": {
    "schemaVersion": 1,
    "kind": "worklouder-input-config-snapshot",
    "contentEncoding": "base64",
    "maxFiles": 4096,
    "maxFileBytes": 16777216,
    "maxTotalDecodedBytes": 33554432,
    "fileDigests": [
      "device-sha1",
      "host-sha256"
    ],
    "revisionAlgorithm": "sha256:path-u32be-path-bytes-size-u64be-content-v1",
    "revisionFraming": [
      "utf8(worklouder-input-config-revision-v1\\0)",
      "for each relativePath sorted lexically by UTF-8 bytes: u32be(path byte length)",
      "utf8(relativePath)",
      "u64be(content byte length)",
      "content bytes"
    ],
    "consistency": "list-read-list",
    "validateExpectedRevision": "optional live compare-and-swap preflight"
  },
  "hostSettings": {
    "schemaVersion": 1,
    "kind": "worklouder-input-host-settings",
    "fields": [
      "showedAnalyticsPopUp",
      "analyticsConsented",
      "smartActionCmdEnabled"
    ],
    "revisionAlgorithm": "sha256:input-host-settings-three-booleans-v1",
    "revisionFraming": [
      "utf8(worklouder-input-host-settings-revision-v1\\0)",
      "u8(showedAnalyticsPopUp ? 1 : 0)",
      "u8(analyticsConsented ? 1 : 0)",
      "u8(smartActionCmdEnabled ? 1 : 0)"
    ],
    "authority": "Input ApplicationService.getAppSettings/saveAppSettings",
    "directDatabaseWrite": false,
    "completeDtoReplacement": true,
    "preserveSiblingFields": true,
    "snapshotBeforeApply": true,
    "compareAndSwapRevision": true,
    "idempotencyRequired": true,
    "readbackAfterApply": true,
    "rollbackOnFailure": true,
    "capabilityAdvertisement": "all three methods are advertised only when hostSettingsAuthority supplies readSettings and replaceSettings"
  },
  "hostSettingsMutationResult": {
    "schemaVersion": 1,
    "kind": "worklouder-input-host-settings-mutation",
    "fields": [
      "operation",
      "idempotencyKey",
      "idempotentReplay",
      "changed",
      "rollbackPerformed",
      "beforeRevision",
      "afterRevision",
      "targetRevision"
    ]
  },
  "appSenseRuntime": {
    "schemaVersion": 1,
    "kind": "worklouder-input-appsense-runtime",
    "authority": "Input nativeService, focusAppService, and existing device session",
    "fields": [
      "collecting",
      "selectedDeviceRegistered",
      "deviceIds",
      "focusedApp",
      "lastForwardedApp",
      "selectedProfileIndex",
      "selectedLayerIndex"
    ],
    "readOnly": true,
    "directFocusMutation": false,
    "guiControl": false,
    "capabilityAdvertisement": "advertised only when appsenseRuntimeAuthority supplies readState"
  },
  "inputEvidence": {
    "testedVersion": "0.18.0",
    "bundleId": "it.focusense.input-app",
    "asarSha256": "8e530188bc693ca1b9950bdc0515adfc349a3563e1841fe61ff2d692dc6b2da8",
    "mainRelativePath": "dist-electron/main/index.js",
    "mainSha256": "7c16191956acb8d0d89c50eb940dc9b757bf6966b19c56499ca2d60d8743154a",
    "existingInternalChannels": [
      "devsManGetDevs",
      "rpcGetDeviceStatus",
      "rpcGetFileList",
      "rpcReadFile",
      "connDeviceChangeDeviceConfig",
      "common-get-app-settings",
      "common-send-app-settings",
      "common-check-app-permissions",
      "devsManGetLatestFwRelease"
    ],
    "quitCleanup": "devicesCommManager.disconnectAllDevices()",
    "externalTransportFound": false
  },
  "tier4ReadAuthorities": {
    "permissions": {
      "authority": "Input ApplicationService.checkAppPermissions backed by WLPermissions",
      "macosMeaning": "Input Monitoring permission for the running Input process",
      "linuxMeaning": "read/write access to the selected HID device path",
      "capabilityAdvertisement": "advertised only when permissionsAuthority supplies readStatus"
    },
    "firmware": {
      "authority": "Input DeviceFlashService release checker and existing device session",
      "network": "the check command may use Input's own release-service network request",
      "mutation": false,
      "capabilityAdvertisement": "advertised only when firmwareAuthority supplies readStatus"
    },
    "logs": {
      "authority": "Input WindowService in-memory renderer log ring",
      "maximumEntries": 5000,
      "maximumMessageBytes": 8192,
      "sanitizedBeforeBridgeResponse": true,
      "redactions": [
        "macOS and Windows user home prefixes",
        "email addresses",
        "authorization, bearer, token, API key, password, and secret values",
        "device IDs, serial values, and UUIDs"
      ],
      "capabilityAdvertisement": "advertised only when logsAuthority supplies readLogs"
    }
  }
}
