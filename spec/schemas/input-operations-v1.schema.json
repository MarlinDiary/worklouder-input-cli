{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://worklouderctl.dev/schemas/input-operations-v1.schema.json",
  "title": "WorkLouderCTL Input operations v1",
  "oneOf": [
    { "$ref": "#/$defs/permissions" },
    { "$ref": "#/$defs/firmware" },
    { "$ref": "#/$defs/firmwarePlan" },
    { "$ref": "#/$defs/firmwareUpdateReceipt" },
    { "$ref": "#/$defs/recoveryPlan" },
    { "$ref": "#/$defs/recoveryReceipt" },
    { "$ref": "#/$defs/resetPlan" },
    { "$ref": "#/$defs/resetReceipt" },
    { "$ref": "#/$defs/logBundle" }
  ],
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "device": {
      "type": "object",
      "required": ["devicePid", "deviceType", "layoutType", "connectionType", "isUsbConnection"]
    },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "fetchedAt", "downloadUrl", "changeLog"],
      "properties": {
        "version": { "type": "string", "minLength": 1, "maxLength": 128 },
        "fetchedAt": { "type": "integer", "minimum": 0 },
        "downloadUrl": { "type": "string", "pattern": "^https?://" },
        "changeLog": { "type": ["string", "null"] }
      }
    },
    "permissions": {
      "type": "object",
      "required": ["schemaVersion", "kind", "adapter", "inputAppVersion", "deviceKitVersion", "device", "permission"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "kind": { "const": "worklouderctl-input-permissions-status" },
        "adapter": { "const": "input-companion-bridge-v1" },
        "inputAppVersion": { "type": "string" },
        "deviceKitVersion": { "type": "string" },
        "device": { "$ref": "#/$defs/device" },
        "permission": {
          "type": "object",
          "additionalProperties": false,
          "required": ["platform", "requiredPermission", "granted", "checkedDevicePaths"],
          "properties": {
            "platform": { "type": "string", "minLength": 1, "maxLength": 32 },
            "requiredPermission": { "enum": ["input-monitoring", "hid-read-write", "none"] },
            "granted": { "type": "boolean" },
            "checkedDevicePaths": { "type": "array", "items": { "type": "string" }, "maxItems": 256 }
          }
        }
      }
    },
    "firmware": {
      "type": "object",
      "required": ["schemaVersion", "kind", "adapter", "inputAppVersion", "deviceKitVersion", "device", "status", "update", "warnings"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "kind": { "const": "worklouderctl-input-firmware-status" },
        "adapter": { "const": "input-companion-bridge-v1" },
        "inputAppVersion": { "type": "string" },
        "deviceKitVersion": { "type": "string" },
        "device": { "$ref": "#/$defs/device" },
        "status": { "type": "object" },
        "update": {
          "type": "object",
          "required": ["updateAvailable", "release"],
          "properties": {
            "updateAvailable": { "type": ["boolean", "null"] },
            "release": {
              "oneOf": [
                { "type": "null" },
                { "$ref": "#/$defs/release" }
              ]
            }
          }
        },
        "warnings": { "type": "array", "items": { "type": "string" } }
      }
    },
    "firmwarePlan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "kind",
        "revisionAlgorithm",
        "revision",
        "deviceId",
        "deviceKitVersion",
        "device",
        "currentFirmwareVersion",
        "targetRelease",
        "configRevision",
        "configFileCount",
        "ready",
        "blockers",
        "phases"
      ],
      "properties": {
        "schemaVersion": { "const": 1 },
        "kind": { "const": "worklouder-input-firmware-plan" },
        "revisionAlgorithm": { "const": "sha256:recursive-key-sorted-firmware-plan-body-v1" },
        "revision": { "$ref": "#/$defs/sha256" },
        "deviceId": { "type": "string", "minLength": 1, "maxLength": 512 },
        "deviceKitVersion": { "type": "string", "minLength": 1, "maxLength": 128 },
        "device": { "$ref": "#/$defs/device" },
        "currentFirmwareVersion": { "type": "string", "minLength": 1, "maxLength": 128 },
        "targetRelease": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/release" }
          ]
        },
        "configRevision": { "$ref": "#/$defs/sha256" },
        "configFileCount": { "type": "integer", "minimum": 1, "maximum": 4096 },
        "ready": { "type": "boolean" },
        "blockers": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 4,
          "items": {
            "enum": [
              "update-availability-unknown",
              "no-update-available",
              "release-unavailable",
              "usb-required"
            ]
          }
        },
        "phases": {
          "const": [
            "backup-configuration",
            "download-input-selected-release",
            "enter-bootloader",
            "flash-with-input-device-programmer",
            "reconnect-original-device",
            "restore-changed-configuration",
            "verify-firmware-and-configuration"
          ]
        }
      }
    },
    "firmwarePhase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "status"],
      "properties": {
        "name": {
          "enum": [
            "backup-configuration",
            "download-input-selected-release",
            "enter-bootloader",
            "flash-with-input-device-programmer",
            "reconnect-original-device",
            "restore-changed-configuration",
            "verify-firmware-and-configuration"
          ]
        },
        "status": { "const": "completed" }
      }
    },
    "firmwareUpdateReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "kind",
        "adapter",
        "inputAppVersion",
        "deviceKitVersion",
        "plan",
        "backup",
        "receipt",
        "operation",
        "idempotencyKey",
        "idempotentReplay",
        "changed",
        "deviceId",
        "planRevision",
        "beforeFirmwareVersion",
        "afterFirmwareVersion",
        "targetFirmwareVersion",
        "beforeConfigRevision",
        "afterConfigRevision",
        "configurationRestored",
        "providerOutcome",
        "recoveryRequired",
        "phases"
      ],
      "properties": {
        "schemaVersion": { "const": 1 },
        "kind": { "const": "worklouderctl-input-firmware-update-receipt" },
        "adapter": { "const": "input-companion-bridge-v1" },
        "inputAppVersion": { "type": "string", "minLength": 1 },
        "deviceKitVersion": { "type": "string", "minLength": 1 },
        "plan": { "type": "string", "minLength": 1 },
        "backup": { "type": "string", "minLength": 1 },
        "receipt": { "type": "string", "minLength": 1 },
        "operation": { "const": "update" },
        "idempotencyKey": { "type": "string", "minLength": 1, "maxLength": 256 },
        "idempotentReplay": { "type": "boolean" },
        "changed": { "type": "boolean" },
        "deviceId": { "type": "string", "minLength": 1, "maxLength": 512 },
        "planRevision": { "$ref": "#/$defs/sha256" },
        "beforeFirmwareVersion": { "type": "string", "minLength": 1, "maxLength": 128 },
        "afterFirmwareVersion": { "type": "string", "minLength": 1, "maxLength": 128 },
        "targetFirmwareVersion": { "type": "string", "minLength": 1, "maxLength": 128 },
        "beforeConfigRevision": { "$ref": "#/$defs/sha256" },
        "afterConfigRevision": { "$ref": "#/$defs/sha256" },
        "configurationRestored": { "const": true },
        "providerOutcome": { "enum": ["completed", "postflight-confirmed"] },
        "recoveryRequired": { "const": false },
        "phases": {
          "type": "array",
          "prefixItems": [
            { "allOf": [{ "$ref": "#/$defs/firmwarePhase" }, { "properties": { "name": { "const": "backup-configuration" } } }] },
            { "allOf": [{ "$ref": "#/$defs/firmwarePhase" }, { "properties": { "name": { "const": "download-input-selected-release" } } }] },
            { "allOf": [{ "$ref": "#/$defs/firmwarePhase" }, { "properties": { "name": { "const": "enter-bootloader" } } }] },
            { "allOf": [{ "$ref": "#/$defs/firmwarePhase" }, { "properties": { "name": { "const": "flash-with-input-device-programmer" } } }] },
            { "allOf": [{ "$ref": "#/$defs/firmwarePhase" }, { "properties": { "name": { "const": "reconnect-original-device" } } }] },
            { "allOf": [{ "$ref": "#/$defs/firmwarePhase" }, { "properties": { "name": { "const": "restore-changed-configuration" } } }] },
            { "allOf": [{ "$ref": "#/$defs/firmwarePhase" }, { "properties": { "name": { "const": "verify-firmware-and-configuration" } } }] }
          ],
          "items": false,
          "minItems": 7,
          "maxItems": 7
        }
      }
    },
    "recoveryBootloader": {
      "type": "object",
      "additionalProperties": false,
      "required": ["transport", "identifier", "deviceType"],
      "properties": {
        "transport": { "type": "string", "minLength": 1, "maxLength": 64 },
        "identifier": { "type": "string", "minLength": 1, "maxLength": 512 },
        "deviceType": { "type": "string", "minLength": 1, "maxLength": 128 }
      }
    },
    "recoveryPlan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "kind",
        "revisionAlgorithm",
        "revision",
        "inputAppVersion",
        "deviceId",
        "deviceKitVersion",
        "device",
        "previousFirmwareVersion",
        "targetRelease",
        "bootloader",
        "configurationRevision",
        "configurationFileCount",
        "phases",
        "blockers",
        "ready"
      ],
      "properties": {
        "schemaVersion": { "const": 1 },
        "kind": { "const": "worklouder-input-recovery-plan" },
        "revisionAlgorithm": { "const": "sha256:recursive-key-sorted-recovery-plan-body-v1" },
        "revision": { "$ref": "#/$defs/sha256" },
        "inputAppVersion": { "type": "string", "minLength": 1, "maxLength": 128 },
        "deviceId": { "type": "string", "minLength": 1, "maxLength": 512 },
        "deviceKitVersion": { "type": "string", "minLength": 1, "maxLength": 128 },
        "device": { "$ref": "#/$defs/device" },
        "previousFirmwareVersion": { "type": "string", "minLength": 1, "maxLength": 128 },
        "targetRelease": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/release" }
          ]
        },
        "bootloader": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/recoveryBootloader" }
          ]
        },
        "configurationRevision": { "$ref": "#/$defs/sha256" },
        "configurationFileCount": { "type": "integer", "minimum": 1, "maximum": 4096 },
        "phases": {
          "const": [
            "detect-input-bootloader",
            "validate-input-selected-release",
            "recover-with-input-device-programmer",
            "reconnect-original-device",
            "restore-exact-configuration",
            "verify-firmware-and-configuration"
          ]
        },
        "blockers": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 2,
          "items": {
            "enum": [
              "input-bootloader-not-detected",
              "input-selected-release-unavailable"
            ]
          }
        },
        "ready": { "type": "boolean" }
      }
    },
    "recoveryPhase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "status"],
      "properties": {
        "name": {
          "enum": [
            "detect-input-bootloader",
            "validate-input-selected-release",
            "recover-with-input-device-programmer",
            "reconnect-original-device",
            "restore-exact-configuration",
            "verify-firmware-and-configuration"
          ]
        },
        "status": { "const": "completed" }
      }
    },
    "recoveryReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "kind",
        "adapter",
        "inputAppVersion",
        "deviceKitVersion",
        "plan",
        "backup",
        "receipt",
        "operation",
        "idempotencyKey",
        "idempotentReplay",
        "changed",
        "deviceId",
        "planRevision",
        "beforeFirmwareVersion",
        "afterFirmwareVersion",
        "targetFirmwareVersion",
        "beforeConfigRevision",
        "recoveredConfigRevision",
        "afterConfigRevision",
        "configurationRestored",
        "providerOutcome",
        "recoveryRequired",
        "phases"
      ],
      "properties": {
        "schemaVersion": { "const": 1 },
        "kind": { "const": "worklouderctl-input-recovery-receipt" },
        "adapter": { "const": "input-companion-bridge-v1" },
        "inputAppVersion": { "type": "string", "minLength": 1, "maxLength": 128 },
        "deviceKitVersion": { "type": "string", "minLength": 1, "maxLength": 128 },
        "plan": { "type": "string", "minLength": 1 },
        "backup": { "type": "string", "minLength": 1 },
        "receipt": { "type": "string", "minLength": 1 },
        "operation": { "const": "recover" },
        "idempotencyKey": { "type": "string", "minLength": 1, "maxLength": 256 },
        "idempotentReplay": { "type": "boolean" },
        "changed": { "const": true },
        "deviceId": { "type": "string", "minLength": 1, "maxLength": 512 },
        "planRevision": { "$ref": "#/$defs/sha256" },
        "beforeFirmwareVersion": { "type": "string", "minLength": 1, "maxLength": 128 },
        "afterFirmwareVersion": { "type": "string", "minLength": 1, "maxLength": 128 },
        "targetFirmwareVersion": { "type": "string", "minLength": 1, "maxLength": 128 },
        "beforeConfigRevision": { "$ref": "#/$defs/sha256" },
        "recoveredConfigRevision": { "$ref": "#/$defs/sha256" },
        "afterConfigRevision": { "$ref": "#/$defs/sha256" },
        "configurationRestored": { "const": true },
        "providerOutcome": { "enum": ["completed", "postflight-confirmed"] },
        "recoveryRequired": { "const": false },
        "phases": {
          "type": "array",
          "prefixItems": [
            { "allOf": [{ "$ref": "#/$defs/recoveryPhase" }, { "properties": { "name": { "const": "detect-input-bootloader" } } }] },
            { "allOf": [{ "$ref": "#/$defs/recoveryPhase" }, { "properties": { "name": { "const": "validate-input-selected-release" } } }] },
            { "allOf": [{ "$ref": "#/$defs/recoveryPhase" }, { "properties": { "name": { "const": "recover-with-input-device-programmer" } } }] },
            { "allOf": [{ "$ref": "#/$defs/recoveryPhase" }, { "properties": { "name": { "const": "reconnect-original-device" } } }] },
            { "allOf": [{ "$ref": "#/$defs/recoveryPhase" }, { "properties": { "name": { "const": "restore-exact-configuration" } } }] },
            { "allOf": [{ "$ref": "#/$defs/recoveryPhase" }, { "properties": { "name": { "const": "verify-firmware-and-configuration" } } }] }
          ],
          "items": false,
          "minItems": 6,
          "maxItems": 6
        }
      }
    },
    "resetPlan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "kind",
        "revisionAlgorithm",
        "revision",
        "inputAppVersion",
        "deviceId",
        "deviceKitVersion",
        "device",
        "firmwareVersion",
        "layoutVersion",
        "strategy",
        "sourceRevision",
        "candidateRevision",
        "candidateFileCount"
      ],
      "properties": {
        "schemaVersion": { "const": 1 },
        "kind": { "const": "worklouder-input-reset-plan" },
        "revisionAlgorithm": { "const": "sha256:recursive-key-sorted-reset-plan-body-v1" },
        "revision": { "$ref": "#/$defs/sha256" },
        "inputAppVersion": { "type": "string", "minLength": 1, "maxLength": 128 },
        "deviceId": { "type": "string", "minLength": 1, "maxLength": 512 },
        "deviceKitVersion": { "type": "string", "minLength": 1, "maxLength": 128 },
        "device": { "$ref": "#/$defs/device" },
        "firmwareVersion": { "type": "string", "minLength": 1, "maxLength": 128 },
        "layoutVersion": { "type": "string", "minLength": 1, "maxLength": 128 },
        "strategy": { "const": "input-default-layout" },
        "sourceRevision": { "$ref": "#/$defs/sha256" },
        "candidateRevision": { "$ref": "#/$defs/sha256" },
        "candidateFileCount": { "type": "integer", "minimum": 1, "maximum": 4096 }
      }
    },
    "resetReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "kind",
        "adapter",
        "plan",
        "candidate",
        "backup",
        "receipt",
        "planRevision",
        "inputAppVersion",
        "deviceId",
        "deviceType",
        "layoutVersion",
        "sourceRevision",
        "candidateRevision",
        "idempotencyKey",
        "idempotentReplay",
        "changed",
        "rollbackPerformed",
        "fileCount",
        "totalBytes"
      ],
      "properties": {
        "schemaVersion": { "const": 1 },
        "kind": { "const": "worklouderctl-input-reset-receipt" },
        "adapter": { "const": "input-companion-bridge-v1" },
        "plan": { "type": "string", "minLength": 1 },
        "candidate": { "type": "string", "minLength": 1 },
        "backup": { "type": "string", "minLength": 1 },
        "receipt": { "type": "string", "minLength": 1 },
        "planRevision": { "$ref": "#/$defs/sha256" },
        "inputAppVersion": { "type": "string", "minLength": 1, "maxLength": 128 },
        "deviceId": { "type": "string", "minLength": 1, "maxLength": 512 },
        "deviceType": { "type": "string", "minLength": 1, "maxLength": 128 },
        "layoutVersion": { "type": "string", "minLength": 1, "maxLength": 128 },
        "sourceRevision": { "$ref": "#/$defs/sha256" },
        "candidateRevision": { "$ref": "#/$defs/sha256" },
        "idempotencyKey": { "type": "string", "minLength": 1, "maxLength": 256 },
        "idempotentReplay": { "type": "boolean" },
        "changed": { "type": "boolean" },
        "rollbackPerformed": { "const": false },
        "fileCount": { "type": "integer", "minimum": 1, "maximum": 4096 },
        "totalBytes": { "type": "integer", "minimum": 0, "maximum": 33554432 }
      }
    },
    "logBundleFile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["relativePath", "size", "sha256"],
      "properties": {
        "relativePath": { "enum": ["logs.json", "logs.txt"] },
        "size": { "type": "integer", "minimum": 0 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "logBundle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "kind", "adapter", "inputAppVersion", "sanitized", "sourceEntryCount", "exportedEntryCount", "truncated", "redactionCount", "files"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "kind": { "const": "worklouderctl-input-log-bundle" },
        "adapter": { "const": "input-companion-bridge-v1" },
        "inputAppVersion": { "type": "string" },
        "sanitized": { "const": true },
        "sourceEntryCount": { "type": "integer", "minimum": 0 },
        "exportedEntryCount": { "type": "integer", "minimum": 0, "maximum": 5000 },
        "truncated": { "type": "boolean" },
        "redactionCount": { "type": "integer", "minimum": 0 },
        "files": { "type": "array", "items": { "$ref": "#/$defs/logBundleFile" }, "minItems": 2, "maxItems": 2 }
      }
    }
  }
}
