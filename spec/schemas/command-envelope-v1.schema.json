{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://worklouderctl.dev/schemas/command-envelope-v1.schema.json",
  "title": "WorkLouderCTL command envelope v1",
  "description": "Deterministic argv envelope for invoking one worklouderctl command without a shell.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "argv"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "argv": {
      "type": "array",
      "minItems": 2,
      "items": { "type": "string", "minLength": 1 },
      "prefixItems": [{ "const": "worklouderctl" }]
    },
    "output": {
      "type": "string",
      "enum": ["json", "text"],
      "default": "json"
    },
    "expectedExitStatuses": {
      "type": "array",
      "items": { "type": "integer", "minimum": 0, "maximum": 8 },
      "uniqueItems": true,
      "default": [0]
    }
  }
}
