{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://worklouderctl.dev/schemas/compatibility-matrix-v1.schema.json",
  "title": "WorkLouderCTL compatibility matrix",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "kind", "releases"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "kind": { "const": "worklouderctl-compatibility-matrix" },
    "releases": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/release" }
    }
  },
  "$defs": {
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "state", "tiers", "evidence", "boundary"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "version": { "type": "string", "minLength": 1, "maxLength": 128 },
        "state": { "enum": ["supported", "read-only", "experimental", "unknown"] },
        "tiers": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "integer", "minimum": 1, "maximum": 4 }
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 256 }
        },
        "boundary": { "type": "string", "minLength": 1, "maxLength": 2048 }
      }
    },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cliVersion", "publicationState", "hostOs", "deviceModels", "authorities", "requiredGates"],
      "properties": {
        "cliVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$" },
        "publicationState": { "enum": ["source-alpha", "prerelease", "released", "withdrawn"] },
        "hostOs": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "deviceModels": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "authorities": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/authority" } },
        "requiredGates": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
      }
    }
  }
}
