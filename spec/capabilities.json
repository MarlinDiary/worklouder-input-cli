{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "schemaVersion": 2,
  "researchSnapshot": "2026-08-05",
  "productGoal": "full-configuration-parity",
  "targetConfigurationGuisOptional": true,
  "providerStrategy": "delegate-to-installed-codex-and-input",
  "implementsHardwareDriver": false,
  "implementsFirmwareProtocol": false,
  "implementsHostActionRuntime": false,
  "target": {
    "device": "Codex Micro",
    "host": "macOS",
    "codexApp": "26.730.61309",
    "inputApp": "0.18.0",
    "firmware": "v0.6.1"
  },
  "tiers": [
    {
      "id": 1,
      "name": "codex-native",
      "authority": [
        "codex-settings",
        "codex-runtime"
      ],
      "dependsOnInput": false,
      "runtimeDependency": "codex",
      "initialCliMode": "transactional",
      "adapter": "codex-settings-bridge",
      "capabilities": [
        "agent-keys",
        "command-keys",
        "voice-button",
        "separate-microphone-keys",
        "codex-dial",
        "codex-joystick",
        "task-status-lighting",
        "global-lighting",
        "runtime-health",
        "runtime-recovery"
      ]
    },
    {
      "id": 2,
      "name": "input-device-config",
      "authority": [
        "device-keymap",
        "device-smart-actions",
        "input-cache",
        "input-database",
        "current-device-owner"
      ],
      "dependsOnInput": false,
      "runtimeDependency": "input-configuration-authority-with-owner-restore",
      "initialCliMode": "transactional",
      "capabilities": [
        "profiles",
        "layers",
        "basic-keys",
        "actions",
        "multi-actions",
        "encoder",
        "joystick-sectors",
        "layer-lighting",
        "linked-apps"
      ],
      "adapter": "owner-preserving-device-configuration"
    },
    {
      "id": 3,
      "name": "input-host-automation",
      "authority": [
        "device-smart-actions",
        "input-database",
        "input-runtime"
      ],
      "dependsOnInput": true,
      "runtimeDependency": "input",
      "initialCliMode": "transactional",
      "capabilities": [
        "smart-actions",
        "appsense",
        "cheat-sheet",
        "radial-menu",
        "command-permission"
      ]
    },
    {
      "id": 4,
      "name": "input-operations",
      "authority": [
        "input-runtime",
        "input-updater",
        "firmware-flasher"
      ],
      "dependsOnInput": true,
      "runtimeDependency": "input",
      "initialCliMode": "gated",
      "capabilities": [
        "diagnostics",
        "logs",
        "permissions",
        "firmware-check",
        "firmware-update",
        "reset",
        "recovery"
      ]
    }
  ]
}
