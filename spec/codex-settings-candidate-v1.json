{
  "schemaVersion": 1,
  "kind": "worklouderctl-codex-settings-candidate-contract",
  "contractAppVersion": "26.730.61309",
  "authority": "codex-settings",
  "inputKind": "worklouderctl-codex-settings-snapshot",
  "outputKind": "worklouderctl-codex-settings-snapshot",
  "receiptKind": "worklouderctl-codex-settings-candidate",
  "revisionAlgorithm": {
    "id": "codex-settings-revision-v1",
    "prefixUtf8": "worklouder-codex-settings-revision-v1\\u0000",
    "payload": "recursive-key-sorted compact JSON of explicit settings"
  },
  "validation": {
    "requireExactSchemaVersion": true,
    "requireExactKind": true,
    "requireExactAdapter": "codex-config-toml-read-v1",
    "requireExactContractAppVersion": true,
    "requireLowercaseSourceSha256": true,
    "requireEmbeddedDefinitionsEqualContract": true,
    "recomputeEffectiveSettings": true,
    "preserveUnknownPrefixedSettings": true,
    "rejectExistingOutput": true,
    "atomicPublishAndReopen": true
  },
  "operations": {
    "agentSourceGet": {
      "command": "codex agent-source get --input SNAPSHOT.json",
      "values": [
        "pinned",
        "recent",
        "priority",
        "custom"
      ]
    },
    "agentSourceSet": {
      "command": "codex agent-source set --input SNAPSHOT.json VALUE --output CANDIDATE.json",
      "changedPath": "/settings/codex-micro-agent-source"
    },
    "agentTapModeGet": {
      "command": "codex agent-key tap-mode get --input SNAPSHOT.json"
    },
    "agentTapModeSet": {
      "command": "codex agent-key tap-mode set --input SNAPSHOT.json ENABLED --output CANDIDATE.json",
      "changedPath": "/settings/codex-micro-single-tap-agent-keys"
    },
    "commandKeyGet": {
      "command": "codex command-key get --input SNAPSHOT.json SLOT"
    },
    "commandKeySet": {
      "command": "codex command-key set --input SNAPSHOT.json SLOT [--keycap KEYCAP] [--command COMMAND_ID | --skill-name NAME --skill-path PATH | --clear-action] --output CANDIDATE.json",
      "changedPathTemplate": "/settings/codex-micro-layout/slots/{slot}"
    },
    "commandKeyReset": {
      "command": "codex command-key reset --input SNAPSHOT.json SLOT --output CANDIDATE.json",
      "source": "frozen layout default for the selected slot"
    },
    "dialModeGet": {
      "command": "codex dial mode get --input SNAPSHOT.json",
      "values": [
        "composer-navigation",
        "reasoning",
        "conversation-scroll",
        "custom"
      ]
    },
    "dialModeSet": {
      "command": "codex dial mode set --input SNAPSHOT.json VALUE --output CANDIDATE.json",
      "changedPath": "/settings/codex-micro-layout/encoderMode"
    },
    "dialGestureGet": {
      "command": "codex dial gesture get --input SNAPSHOT.json GESTURE"
    },
    "dialGestureSet": {
      "command": "codex dial gesture set --input SNAPSHOT.json GESTURE [--command COMMAND_ID | --skill-name NAME --skill-path PATH] --output CANDIDATE.json",
      "changedPathTemplate": "/settings/codex-micro-layout/encoder/{gesture}",
      "requiresMode": "custom"
    },
    "dialGestureClear": {
      "command": "codex dial gesture clear --input SNAPSHOT.json GESTURE --output CANDIDATE.json",
      "value": null,
      "requiresMode": "custom"
    },
    "joystickGet": {
      "command": "codex joystick get --input SNAPSHOT.json DIRECTION"
    },
    "joystickSet": {
      "command": "codex joystick set --input SNAPSHOT.json DIRECTION [--command COMMAND_ID | --skill-name NAME --skill-path PATH] --output CANDIDATE.json",
      "changedPathTemplate": "/settings/codex-micro-layout/analogStick/{direction}"
    },
    "joystickClear": {
      "command": "codex joystick clear --input SNAPSHOT.json DIRECTION --output CANDIDATE.json",
      "value": null
    },
    "layoutReset": {
      "command": "codex reset layout --input SNAPSHOT.json --output CANDIDATE.json",
      "changedPath": "/settings/codex-micro-layout",
      "source": "exact installed-build codex-micro-layout default"
    },
    "lightingBrightnessGet": {
      "command": "codex lighting brightness get --input SNAPSHOT.json",
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "lightingBrightnessSet": {
      "command": "codex lighting brightness set --input SNAPSHOT.json VALUE --output CANDIDATE.json",
      "changedPath": "/settings/codex-micro-lighting-brightness"
    },
    "lightingAutoOffGet": {
      "command": "codex lighting auto-off get --input SNAPSHOT.json",
      "values": [
        "off",
        "30-seconds",
        "1-minute",
        "3-minutes",
        "10-minutes",
        "30-minutes",
        "1-hour"
      ]
    },
    "lightingAutoOffSet": {
      "command": "codex lighting auto-off set --input SNAPSHOT.json VALUE --output CANDIDATE.json",
      "changedPath": "/settings/codex-micro-lighting-auto-off"
    },
    "voiceGet": {
      "command": "codex voice get --input SNAPSHOT.json",
      "values": [
        "push-to-talk",
        "realtime"
      ]
    },
    "voiceSet": {
      "command": "codex voice set --input SNAPSHOT.json VALUE --output CANDIDATE.json",
      "changedPath": "/settings/codex-micro-layout/voiceButtonMode"
    },
    "separateMicrophoneKeysGet": {
      "command": "codex voice separate-keys get --input SNAPSHOT.json"
    },
    "separateMicrophoneKeysSet": {
      "command": "codex voice separate-keys set --input SNAPSHOT.json ENABLED --output CANDIDATE.json",
      "changedPath": "/settings/codex-micro-layout/separateMicrophoneKeys"
    },
    "separateMicrophoneKeysReset": {
      "command": "codex voice separate-keys reset --input SNAPSHOT.json --output CANDIDATE.json",
      "value": false,
      "changedPath": "/settings/codex-micro-layout/separateMicrophoneKeys"
    }
  },
  "commandKeySlots": [
    "ACT06",
    "ACT07",
    "ACT08",
    "ACT09",
    "ACT10",
    "ACT11",
    "ACT10_ACT11",
    "ACT12"
  ],
  "commandKeyRules": {
    "preserveCurrentKeycapWhenOmitted": true,
    "commandRepresentation": {
      "keycapId": "KEYCAP",
      "commandId": "COMMAND_ID"
    },
    "skillRepresentation": {
      "keycapId": "KEYCAP",
      "action": {
        "type": "skill",
        "skillName": "NAME",
        "skillPath": "PATH"
      }
    },
    "clearActionPreservesKeycap": true,
    "commandAndActionAreMutuallyExclusive": true
  },
  "dialRules": {
    "modeChangePreservesGestureMapping": true,
    "customGestureEditorRequiresCustomMode": true,
    "gestureActionTypes": [
      "command",
      "skill",
      "empty"
    ],
    "longPressUsesCustomActionOnlyInCustomMode": true,
    "nonCustomLongPressOpensCodexMicroSettings": true
  },
  "joystickRules": {
    "directions": [
      "up",
      "right",
      "down",
      "left"
    ],
    "actionTypes": [
      "command",
      "skill",
      "empty"
    ],
    "oneDirectionPerCandidate": true,
    "preserveUntargetedDirections": true
  },
  "layoutResetRules": {
    "replaceCompleteLayout": true,
    "preserveOtherSettings": true,
    "defaultSource": "frozen exact-version installed-build definition",
    "inheritedDefaultIsNoop": true
  },
  "candidateBoundary": {
    "contactsCodex": false,
    "contactsInput": false,
    "contactsDevice": false,
    "writesSourceConfig": false,
    "futureApplyAuthority": "Codex settings-write bridge",
    "futureApplyCasField": "expectedSourceSha256"
  }
}
